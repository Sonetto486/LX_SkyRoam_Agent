# 生产环境 Docker 配置示例
# 复制此文件为 .env.docker.prod 并修改配置

# ==================== 数据库配置 ====================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here  # 请修改为强密码
POSTGRES_DB=skyroam

# ==================== 应用配置 ====================
APP_NAME=SkyRoam
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=your_very_secure_secret_key_here  # 请修改为随机字符串

# ==================== 服务器配置 ====================
HOST=0.0.0.0
PORT=8001
NGINX_PORT=80  # 对外暴露端口

# ==================== Redis 配置 ====================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_WORKER_POOL=threads
CELERY_WORKER_CONCURRENCY=4

# ==================== LLM 配置 ====================
# 智谱 AI（推荐）
OPENAI_API_KEY=your_zhipu_api_key
OPENAI_MODEL=glm-4-flash
OPENAI_MAX_TOKENS=65536
OPENAI_TEMPERATURE=0.7
OPENAI_API_BASE=https://open.bigmodel.cn/api/paas/v4
OPENAI_TIMEOUT=300
OPENAI_MAX_RETRIES=3

# 或使用 DashScope（阿里云）
# OPENAI_API_KEY=your_dashscope_api_key
# OPENAI_MODEL=qwen-turbo
# OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# ==================== 地图服务配置 ====================
MAP_PROVIDER=amap
MAP_PROVIDER_FALLBACK=amap,baidu,tianditu
AMAP_API_KEY=your_amap_api_key
BAIDU_MAPS_API_KEY=your_baidu_api_key
TIANDITU_API_KEY=your_tianditu_api_key

# ==================== 前端配置 ====================
REACT_APP_API_BASE_URL=http://your-domain.com/api/v1  # 或使用 http://localhost/api/v1
REACT_APP_AMAP_KEY=your_amap_api_key

# ==================== 安全配置 ====================
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=360

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10 MB
LOG_RETENTION=5
LOG_COMPRESSION=zip
LOG_TO_CONSOLE=true
LOG_TO_FILE=true

# ==================== 缓存配置 ====================
CACHE_TTL=3600
CACHE_MAX_SIZE=1000
POI_CACHE_TTL=604800  # 7天
GEOCODE_CACHE_TTL=7776000  # 90天

# ==================== 任务配置 ====================
TASK_TIMEOUT=300
MAX_CONCURRENT_TASKS=10

# ==================== 限流配置 ====================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=10
RATE_LIMIT_WHITELIST=[]
RATE_LIMIT_EXCLUDE_PATHS=["/docs","/redoc","/openapi.json","/health"]

# ==================== 文件存储 ====================
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# ==================== SSE 配置 ====================
PLAN_STATUS_STREAM_INTERVAL=2
PLAN_STATUS_STREAM_MAX_SECONDS=900

# ==================== 小红书服务 ====================
XHS_API_BASE=http://xhs-api:8002